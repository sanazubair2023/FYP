@model MaidAndServantt.Models.Client
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Profile Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
            body {
                background-color: #fcfcfc;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                color: #1a1a1a;
            }

            .dashboard-wrapper {
                max-width: 800px;
                margin: 2rem auto;
                background: #ffffff;
                padding: 20px 40px;
            }

            /* Back Arrow */
            .back-nav {
                font-size: 1.25rem;
                color: #1a1a1a;
                text-decoration: none;
                display: inline-block;
                margin-bottom: 1.5rem;
            }

            .greeting-text {
                color: #8c8c8c;
                font-size: 0.95rem;
                font-weight: 500;
            }

            .user-name {
                font-size: 1.85rem;
                font-weight: 800;
                color: #000000;
                letter-spacing: -0.5px;
            }

            /* Profile Picture */
            .profile-img-container {
                width: 85px;
                height: 85px;
                border-radius: 50%;
                overflow: hidden;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            }

            .profile-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            /* Top Action Buttons */
            .btn-pill {
                border-radius: 25px;
                font-size: 0.85rem;
                font-weight: 700;
                padding: 8px 22px;
                border: none;
                text-decoration: none;
                transition: all 0.2s ease;
            }

            .btn-pill-blue {
                background-color: #216be8;
                color: #ffffff;
            }

                .btn-pill-blue:hover {
                    background-color: #1856bd;
                    color: #ffffff;
                }

            /* Information & Status Cards */
            .card-custom {
                background: #ffffff;
                border: 1px solid #f0f0f0;
                border-radius: 20px;
                padding: 20px 24px;
                box-shadow: 0 8px 20px rgba(0,0,0,0.03);
            }

            .info-item {
                display: flex;
                align-items: center;
                gap: 15px;
                color: #2c2c2c;
                font-weight: 600;
                font-size: 0.95rem;
            }

                .info-item i {
                    color: #e53935;
                    font-size: 1.1rem;
                }

                .info-item .fa-phone {
                    color: #2c2c2c;
                }

            /* Navigation Grid Buttons */
            .nav-grid-btn {
                background: #216be8;
                color: #ffffff;
                font-weight: 700;
                border-radius: 25px;
                padding: 14px 10px;
                text-align: center;
                text-decoration: none;
                font-size: 0.92rem;
                display: block;
                box-shadow: 0 4px 12px rgba(33, 107, 232, 0.2);
                transition: all 0.2s ease;
            }

                .nav-grid-btn:hover {
                    color: #ffffff;
                    background: #1856bd;
                    transform: translateY(-1px);
                }

            /* Headings */
            .section-heading {
                font-size: 1.35rem;
                font-weight: 800;
                color: #000000;
                margin-top: 1.8rem;
                margin-bottom: 1rem;
            }

            /* Status Cards */
            .status-box {
                background: #ffffff;
                border: 1px solid #f0f0f0;
                border-radius: 20px;
                padding: 16px 20px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 8px 20px rgba(0,0,0,0.03);
            }

            .status-box-title {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 0.88rem;
                font-weight: 700;
                color: #4a4a4a;
            }

                .status-box-title i {
                    font-size: 1.2rem;
                    color: #2c2c2c;
                }

            .status-box-count {
                font-size: 1.35rem;
                font-weight: 800;
                color: #000000;
            }

            /* Worker Item Cards */
            .worker-card {
                border: 1px solid #f0f0f0;
                border-radius: 20px;
                padding: 20px;
                background: #ffffff;
                box-shadow: 0 8px 20px rgba(0,0,0,0.03);
            }

            .worker-avatar {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                object-fit: cover;
                background: #f0f0f0;
            }

            .badge-role {
                border: 1px solid #706fd3;
                color: #706fd3;
                font-size: 0.75rem;
                border-radius: 10px;
                padding: 3px 10px;
                font-weight: 600;
            }

            .badge-status {
                border: 1px solid #706fd3;
                color: #706fd3;
                font-size: 0.8rem;
                border-radius: 12px;
                padding: 4px 14px;
                font-weight: 600;
            }

            .btn-action {
                border-radius: 12px;
                font-weight: 700;
                font-size: 0.85rem;
                padding: 6px 15px;
                min-width: 100px;
            }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="dashboard-wrapper w-100">

            <!-- Back Nav Icon -->
            <a href="javascript:history.back()" class="back-nav">
                <i class="fa-solid fa-arrow-left"></i>
            </a>

            <!-- User Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <span class="greeting-text d-block">Good Morning</span>
                    <h1 class="user-name mb-3">@Model.Name</h1>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Login", "Dashboard")" class="btn-pill btn-pill-blue">Logout</a>
                        <a href="@Url.Action("EditProfile", "Dashboard")" class="btn-pill btn-pill-blue">Edit Profile</a>
                    </div>
                </div>

                <div class="profile-img-container">
                    @if (Model.Picture != null && !string.IsNullOrEmpty(Model.Picture.ToString()))
                    {
                        <img src="@Model.Picture" class="profile-img" alt="Profile" />
                    }
                    else
                    {
                        <div class="profile-img bg-secondary d-flex align-items-center justify-content-center text-white">
                            <i class="fa-solid fa-user fs-3"></i>
                        </div>
                    }
                </div>
            </div>

            <!-- Contact Information Card -->
            <div class="card-custom mb-4">
                <div class="info-item mb-3">
                    <i class="fa-solid fa-location-dot"></i>
                    <span>@(Model.Address ?? "No Address Added")</span>
                </div>
                <div class="info-item">
                    <i class="fa-solid fa-phone"></i>
                    <span>@Model.Phone</span>
                </div>
            </div>

            <!-- Quick Navigation Grid (2x2 Buttons) -->
            <div class="row g-3 mb-2">
                <div class="col-6">
                    <a href="@Url.Action("SearchWorker", "Dashboard")" class="nav-grid-btn">Services</a>
                </div>
                <div class="col-6">
                    <a href="@Url.Action("InterviewList", "Dashboard")" class="nav-grid-btn">Interview Requests</a>
                </div>
                <div class="col-6">
                    <a href="@Url.Action("JobRequests", "WorkerDecision")" class="nav-grid-btn">Job Requests</a>
                </div>
                <div class="col-6">
                    @{
                        var resignedWorker = (ViewBag.CurrentWorkers as IEnumerable<dynamic>)?
                            .FirstOrDefault(w => w.DutyStatus != null && w.DutyStatus.ToString().Trim().Equals("Resigned", StringComparison.OrdinalIgnoreCase));

                        int activeResignationId = resignedWorker != null ? Convert.ToInt32(resignedWorker.ResignationId) : 0;
                    }
                    <a href="@Url.Action("GetResignationDetails", "ResignationDetail", new { resignationId = activeResignationId })" class="nav-grid-btn">Resignations</a>
                </div>
            </div>

            <!-- Current Status Section -->
            <h2 class="section-heading">Current Status</h2>
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="status-box">
                        <div class="status-box-title">
                            <i class="fa-solid fa-user-group"></i>
                            <span>Workers</span>
                        </div>
                        <span class="status-box-count">@(ViewBag.ActiveWorkersCount ?? 0)</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="status-box">
                        <div class="status-box-title">
                            <i class="fa-regular fa-clock"></i>
                            <span>interview pending</span>
                        </div>
                        <span class="status-box-count">@(ViewBag.PendingInterviews ?? 0)</span>
                    </div>
                </div>
            </div>

            <!-- Current Worker Section -->
            <h2 class="section-heading">Current Worker</h2>

            @if (ViewBag.CurrentWorkers != null && ((IEnumerable<dynamic>)ViewBag.CurrentWorkers).Any())
            {
                <div class="row g-3">
                    @foreach (var worker in ViewBag.CurrentWorkers)
                    {
                        <div class="col-12" id="w-card-@worker.WorkerId">
                            <div class="worker-card">
                                <div class="d-flex gap-3 align-items-center mb-3">
                                    @if (worker.Picture != null && !string.IsNullOrEmpty(worker.Picture.ToString()))
                                    {
                                        <img src="@worker.Picture" class="worker-avatar" alt="Worker Profile" />
                                    }
                                    else
                                    {
                                        <div class="worker-avatar d-flex align-items-center justify-content-center">
                                            <i class="fa-solid fa-user-tie text-secondary fs-4"></i>
                                        </div>
                                    }
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="fw-bold m-0 text-dark">@worker.Name</h5>
                                            <span class="badge-role">@worker.SkillName</span>
                                        </div>
                                        <p class="text-muted small m-0 mt-1">
                                            <i class="fa-solid fa-location-dot text-danger me-1"></i> @(worker.Address ?? "Not Provided")
                                        </p>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    @if (worker.DutyStatus.ToString().Trim().Equals("Resigned", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge-status text-warning border-warning bg-light">Resigned</span>
                                        <div class="d-flex gap-2">
                                            <a href="@Url.Action("GetResignationDetails", "ResignationDetail", new { resignationId = worker.ResignationId })" class="btn btn-warning btn-action text-white">
                                                Resignation
                                            </a>
                                            <button class="btn btn-danger btn-action" onclick="removeWorkerIndex(@worker.WorkerId)">Delete</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge-status text-success border-success bg-light">On Work</span>
                                        <button class="btn btn-primary btn-action" onclick="terminateContract(@worker.WorkerId)">Terminate</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State Message matching UI Image -->
                <div class="text-center py-4">
                    <p class="text-muted fst-italic" style="color: #9e9e9e !important;">You haven't hired any workers yet.</p>
                </div>
            }

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function removeWorkerIndex(id) {
        if (confirm("Confirm removal of this record?")) {
        $.ajax({
        url: '/Dashboard/RemoveWorkerRecord',
        type: 'POST',
        data: { workerId: id },
        success: function (response) {
        if (response.success) {
        $("#w-card-" + id).fadeOut(500, function () { $(this).remove(); });
        } else {
        alert(response.message || "Could not remove the record.");
        }
        },
        error: function () {
        alert("Error contacting the server.");
        }
        });
        }
        }

        function terminateContract(workerId) {
        window.location.href = '/Termination/Terminate?interviewId=' + workerId;
        }
    </script>
</body>
</html>