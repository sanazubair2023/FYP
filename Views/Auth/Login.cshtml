@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maid & Servant Online - Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            body {
                background-color: #f4f8fc;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

            .login-card {
                background: #ffffff;
                max-width: 450px;
                width: 100%;
                border-radius: 32px;
                padding: 2.5rem 2rem;
                box-shadow: 0 15px 35px rgba(30, 116, 237, 0.04);
                border: none;
            }

            .logo-box {
                width: 100px;
                height: 100px;
                background: #ffffff;
                border-radius: 28px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1rem auto;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
                overflow: hidden;
                position: relative;
            }

            .logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                mix-blend-mode: multiply;
                transform: scale(1.65);
                object-position: center 22%;
            }

            .brand-title {
                color: #2c447e;
                font-size: 1.4rem;
                font-weight: 700;
                margin-bottom: 1.5rem;
                text-align: center;
            }

            /* Responsive grid layout for 4 role tabs */
            .role-tabs-container {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
                margin-bottom: 1.5rem;
            }

            .role-tab {
                border: 1px solid #e2e8f0;
                background: #ffffff;
                padding: 10px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-weight: 600;
                color: #4a5568;
                cursor: pointer;
                transition: all 0.2s ease;
                font-size: 0.88rem;
            }

                .role-tab i {
                    font-size: 1rem;
                    color: #1e74ed;
                }

                .role-tab.active {
                    background: #ffffff;
                    border-color: #1e74ed;
                    box-shadow: 0 4px 12px rgba(30, 116, 237, 0.12);
                    color: #111;
                }

            .modern-input-group {
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                display: flex;
                align-items: center;
                padding: 12px 16px;
                margin-bottom: 1.2rem;
                background: white;
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
                transition: border-color 0.2s;
            }

                .modern-input-group:focus-within {
                    border-color: #1e74ed;
                }

                .modern-input-group .field-icon {
                    color: #1e74ed;
                    font-size: 1.15rem;
                    margin-right: 14px;
                    width: 20px;
                    text-align: center;
                }

                .modern-input-group input {
                    border: none;
                    outline: none;
                    width: 100%;
                    font-size: 0.95rem;
                    color: #2d3748;
                    background: transparent;
                }

                    .modern-input-group input::placeholder {
                        color: #a0aec0;
                    }

                .modern-input-group .toggle-password {
                    color: #718096;
                    cursor: pointer;
                    margin-left: 10px;
                    font-size: 1.1rem;
                }

            .options-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
                font-size: 0.88rem;
            }

            .btn-pill-submit {
                width: 100%;
                background: #ffffff;
                border: 2px solid #1e74ed;
                color: #1e74ed;
                padding: 12px;
                border-radius: 30px;
                font-weight: 700;
                font-size: 1rem;
                cursor: pointer;
                box-shadow: 0 4px 12px rgba(30, 116, 237, 0.05);
                margin-bottom: 0.5rem;
                transition: all 0.2s;
            }

                .btn-pill-submit:hover {
                    background-color: #f4f8fc;
                }

            .btn-pill-outline {
                display: block;
                width: 100%;
                background-color: #1e74ed;
                color: #ffffff;
                font-weight: 700;
                font-size: 1rem;
                border-radius: 30px;
                padding: 12px;
                text-decoration: none;
                text-align: center;
                box-shadow: 0 6px 18px rgba(30, 116, 237, 0.25);
                border: none;
                transition: all 0.2s;
            }

                .btn-pill-outline:hover {
                    background-color: #1663cc;
                    color: #ffffff;
                }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-box">
            <img src="/Images/logo.png" alt="Maid & Servant Online" class="logo-img" />
        </div>
        <div class="brand-title">Maid & Servant Online</div>

        <form action="@Url.Action("Login", "Auth")" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger p-2 text-center" style="border-radius: 12px; font-size: 0.85rem;">
                    @Html.ValidationSummary(false, "")
                </div>
            }

            <input type="hidden" name="Role" id="hidden-role-input" value="Client" />

            <!-- 4 Role Tabs Grid -->
            <div class="role-tabs-container">
                <div class="role-tab active" data-role="Client" onclick="selectRole('Client')">
                    <i class="fa-regular fa-user"></i>
                    Client
                </div>
                <div class="role-tab" data-role="Worker" onclick="selectRole('Worker')">
                    <i class="fa-solid fa-users-gear"></i>
                    Worker
                </div>
                <div class="role-tab" data-role="Company" onclick="selectRole('Company')">
                    <i class="fa-solid fa-building"></i>
                    Company
                </div>
                <div class="role-tab" data-role="Police" onclick="selectRole('Police')">
                    <i class="fa-solid fa-shield-halved"></i>
                    Police
                </div>
            </div>

            <div class="modern-input-group">
                <i id="login-identifier-icon" class="fa-regular fa-envelope field-icon"></i>
                <input type="email" name="LoginIdentifier" id="login-identifier-input" placeholder="Email" required />
            </div>

            <div class="modern-input-group">
                <i class="fa-solid fa-lock field-icon"></i>
                <input type="password" name="Password" id="password-field" placeholder="Password" required />
                <i id="toggle-icon" class="fa-regular fa-eye toggle-password" onclick="togglePasswordVisibility()"></i>
            </div>

            <div class="options-row">
                <label style="cursor: pointer; display: flex; align-items: center; color: #718096;">
                    <input type="checkbox" name="RememberMe" id="RememberMe" value="true" style="margin-right: 8px; width: 16px; height: 16px; accent-color: #1e74ed;">
                    Remember Me
                </label>
                <a href="#" style="color: #1e74ed; text-decoration: none; font-weight: 600;">Forgot Password?</a>
            </div>

            <button type="submit" class="btn-pill-submit">Sign in</button>

            <div style="text-align: center; margin: 10px 0; font-size: 0.85rem; font-weight: bold; color: #a0aec0;">OR</div>

            <a href="@Url.Action("Signup", "Auth")" class="btn-pill-outline">Signup</a>
        </form>
    </div>

    <script>
            function togglePasswordVisibility() {
                var passwordField = document.getElementById("password-field");
                var toggleIcon = document.getElementById("toggle-icon");
                if (passwordField.type === "password") {
                    passwordField.type = "text";
                    toggleIcon.className = "fa-regular fa-eye-slash";
                } else {
                    passwordField.type = "password";
                    toggleIcon.className = "fa-regular fa-eye";
                }
            }

            function selectRole(role) {
                document.querySelectorAll('.role-tab').forEach(tab => {
                    tab.classList.remove('active');
                });
                document.querySelector(`.role-tab[data-role="${role}"]`).classList.add('active');

                document.getElementById('hidden-role-input').value = role;

                var inputField = document.getElementById("login-identifier-input");
                var icon = document.getElementById("login-identifier-icon");

                if (role === "Worker") {
                    inputField.type = "text";
                    inputField.placeholder = "CNIC (e.g., 3740512345677)";
                    inputField.setAttribute("maxlength", "15");
                    icon.className = "fa-solid fa-id-card field-icon";
                } else if (role === "Company") {
                    inputField.type = "text";
                    inputField.placeholder = "License Number";
                    inputField.removeAttribute("maxlength");
                    icon.className = "fa-solid fa-file-contract field-icon";
                } else if (role === "Police") {
                    inputField.type = "text";
                    inputField.placeholder = "Badge Number";
                    inputField.removeAttribute("maxlength");
                    icon.className = "fa-solid fa-id-badge field-icon";
                } else {
                    inputField.type = "email";
                    inputField.placeholder = "Email";
                    inputField.removeAttribute("maxlength");
                    icon.className = "fa-regular fa-envelope field-icon";
                }
                inputField.value = "";
            }
    </script>
</body>
</html>