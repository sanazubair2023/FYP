@model MaidAndServantt.Models.WorkerReviewsViewModel

@{
    ViewData["Title"] = "Rating & Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #F8F9FA;
    }

    .reviews-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }

    .header-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #E0E0E0;
        margin-bottom: 25px;
    }

    .header-title {
        font-size: 18px;
        color: #333;
        margin-bottom: 10px;
    }

    .rating-row {
        display: flex;
        align-items: center;
    }

    .big-rating {
        font-size: 48px;
        font-weight: bold;
        color: #1E4A84;
        margin-right: 15px;
        line-height: 1;
    }

    .star-icon {
        color: #FFD700;
        font-size: 1.2rem;
    }

    .star-icon-lg {
        color: #FFD700;
        font-size: 1.8rem;
    }

    .star-empty {
        color: #E0E0E0;
    }

    .review-count-text {
        font-size: 15px;
        color: #888;
        margin-top: 8px;
    }

    .review-card {
        background-color: #FFFFFF;
        border-radius: 15px;
        padding: 18px;
        margin-bottom: 15px;
        border: 1px solid #E0E0E0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }

    .reviewer-name {
        font-size: 16px;
        font-weight: bold;
        color: #000;
        margin: 0;
    }

    .date-row {
        font-size: 12px;
        color: #888;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .comment-text {
        font-size: 14px;
        color: #555;
        font-style: italic;
        margin-top: 10px;
        line-height: 1.5;
    }

    .back-btn {
        background-color: #1E75EB;
        color: #FFFFFF !important;
        border-radius: 25px;
        height: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        font-size: 16px;
        text-decoration: none;
        margin-top: 25px;
        box-shadow: 0 3px 8px rgba(30, 117, 235, 0.3);
        transition: background-color 0.2s ease;
    }

        .back-btn:hover {
            background-color: #155bc4;
        }

    .empty-container {
        text-align: center;
        padding: 50px 20px;
    }
</style>

<div class="reviews-container">

    <!-- Overall Rating Header Card -->
    <div class="header-card">
        <div class="header-title">Overall Rating</div>
        <div class="rating-row">
            <div class="big-rating">@Model.AverageRating.ToString("0.0")</div>
            <div>
                @{
                    int roundedHeaderStars = (int)Math.Round(Model.AverageRating);
                    for (int i = 1; i <= 5; i++)
                    {
                        if (i <= roundedHeaderStars)
                        {
                            <i class="bi bi-star-fill star-icon-lg"></i>
                        }
                        else
                        {
                            <i class="bi bi-star star-icon-lg star-empty"></i>
                        }
                    }
                }
            </div>
        </div>
        <div class="review-count-text">(@Model.ReviewCount Reviews)</div>
    </div>

    <!-- Reviews List -->
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        @foreach (var item in Model.Reviews)
        {
            <div class="review-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="reviewer-name">@item.Name</h5>
                        <div class="date-row">
                            <i class="bi bi-calendar-range"></i>
                            <span>@item.Date</span>
                        </div>
                    </div>
                    <div>
                        @{
                            int itemStars = (int)Math.Round(item.Rating);
                            for (int i = 1; i <= 5; i++)
                            {
                                if (i <= itemStars)
                                {
                                    <i class="bi bi-star-fill star-icon"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star star-icon star-empty"></i>
                                }
                            }
                        }
                    </div>
                </div>
                <div class="comment-text">
                    "@item.Comment"
                </div>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-container">
            <i class="bi bi-chat-square-dots text-muted" style="font-size: 50px;"></i>
            <p class="text-muted fst-italic mt-2">No reviews available yet.</p>
        </div>
    }

    <!-- Back Button -->
    <a href="javascript:history.back()" class="back-btn">
        Back
    </a>

</div>