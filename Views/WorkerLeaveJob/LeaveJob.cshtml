@model MaidAndServantt.Controllers.ResignationViewModel

@{
    ViewData["Title"] = "Leave Job";
}

<!-- Bootstrap Icons & Fonts -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f8f9fa;
    }

    .leave-container {
        max-width: 500px;
        margin: 30px auto;
        background: #fff;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
    }

    .bg-decoration {
        position: absolute;
        top: -50px;
        left: -50px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background-color: #E3F2FD;
        z-index: 0;
    }

    .content-wrap {
        position: relative;
        z-index: 1;
    }

    .header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .header-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #333;
        margin: 0;
    }

    .job-card {
        background-color: #FFF;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid #EEE;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .employer-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #333;
    }

    .employer-address {
        font-size: 0.9rem;
        color: #666;
        margin-top: 2px;
    }

    .notice-badge {
        background-color: #E3F2FD;
        display: inline-block;
        padding: 4px 12px;
        border-radius: 8px;
        margin-top: 12px;
    }

    .notice-text {
        color: #1E64D3;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .form-label-custom {
        font-weight: 700;
        color: #000;
        margin-bottom: 8px;
    }

    .custom-input {
        border-radius: 12px;
        border: 1px solid #DDD;
        background-color: #F9F9F9;
        padding: 12px;
    }

    .btn-submit {
        background-color: #E91E63;
        color: #FFF;
        font-weight: 700;
        border-radius: 15px;
        height: 50px;
        border: none;
        width: 100%;
        margin-top: 15px;
        transition: 0.3s;
    }

        .btn-submit:hover {
            background-color: #d81b60;
            color: #FFF;
        }

    .btn-cancel {
        display: block;
        text-align: center;
        color: #666;
        text-decoration: none;
        font-weight: 500;
        margin-top: 15px;
    }
</style>

<div class="leave-container">
    <div class="bg-decoration"></div>

    <div class="content-wrap">
        <!-- Header -->
        <div class="header-bar">
            <a href="@Url.Action("WorkerDashboard", "WorkerDashboard")" class="text-dark">
                <i class="bi bi-arrow-left fs-4"></i>
            </a>
            <h2 class="header-title">Leave job</h2>
            <img src="/Images/logo.png" alt="Logo" style="width: 25px; height: 25px;" />
        </div>

        <!-- Global Error Messages -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Active Job Card -->
        <div class="job-card">
            <div class="employer-name">@Model.EmployerName</div>
            <div class="employer-address">@Model.EmployerAddress</div>
            <div class="notice-badge">
                <span class="notice-text">Standard 1-Week Notice</span>
            </div>
        </div>

        <!-- Resignation Form -->
        <form asp-action="LeaveJob" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InterviewId" />
            <input type="hidden" asp-for="EmployerName" />
            <input type="hidden" asp-for="EmployerAddress" />

            <!-- Last Working Day -->
            <div class="mb-4">
                <label class="form-label form-label-custom">Proposed Last Working Day</label>
                <div class="input-group">
                    <input type="date" asp-for="LastWorkingDate"
                           class="form-control custom-input"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           value="@Model.LastWorkingDate.ToString("yyyy-MM-dd")" required />
                </div>
                <span asp-validation-for="LastWorkingDate" class="text-danger small"></span>
            </div>

            <!-- Reason Input -->
            <div class="mb-4">
                <label class="form-label form-label-custom">Reason for Leaving</label>
                <textarea asp-for="ResignationReason" class="form-control custom-input" rows="4"
                          placeholder="Please explain why you are leaving..."></textarea>
                <span asp-validation-for="ResignationReason" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-submit">Submit Resignation Notice</button>

            <!-- Cancel Link -->
            <a href="@Url.Action("WorkerDashboard", "WorkerDashboard")" class="btn-cancel">Cancle</a>
        </form>
    </div>
</div>