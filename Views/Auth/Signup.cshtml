@model dynamic
@{
    bool isEditMode = ViewBag.IsEditMode ?? false;
    string userRole = ViewBag.UserRole ?? "Client";
    ViewBag.Title = isEditMode ? "Edit Profile" : "Create Account";
    Layout = null;

    // RuntimeBinderException se bachne ke liye dynamic model ke variables
    var mName = "";
    var mEmail = "";
    var mPhone = "";
    var mAddress = "";
    var mAge = "";
    var mCnic = "";
    var mSalary = "";
    var mGender = "";
    var mPicture = "";
    var mId = "";

    if (Model != null)
    {
        try { mName = Model.Name ?? ""; } catch { }
        try { mEmail = Model.Email ?? ""; } catch { }
        try { mPhone = Model.Phone ?? ""; } catch { }
        try { mAddress = Model.Address ?? ""; } catch { }
        try { mAge = Model.Age != null ? Model.Age.ToString() : ""; } catch { }
        try { mCnic = Model.Cnic ?? ""; } catch { }
        try { mSalary = Model.Salary != null ? Model.Salary.ToString() : ""; } catch { }
        try { mGender = Model.Gender ?? ""; } catch { }
        try { mPicture = Model.Picture ?? ""; } catch { }
        try { mId = userRole == "Worker" ? (Model.WorkerId != null ? Model.WorkerId.ToString() : "") : (Model.ClientId != null ? Model.ClientId.ToString() : ""); } catch { }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(isEditMode ? "Edit Profile" : "Create Account") - Servant Maid Online</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #f7f9fc;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .register-card {
            background: #ffffff;
            max-width: 420px;
            width: 100%;
            border-radius: 24px;
            position: relative;
            overflow: hidden;
            padding: 2rem 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: none;
        }

        .header-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #f1f3f9;
            padding-bottom: 10px;
            margin-bottom: 1.5rem;
        }

        .btn-back-circle {
            background: #f1f3f9;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4a5568;
            text-decoration: none;
        }

        .header-title {
            color: #112663;
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0;
        }

        .custom-input-group {
            border: 1px solid #e2e8f0;
            border-radius: 30px;
            display: flex;
            align-items: center;
            padding: 4px 12px;
            margin-bottom: 1rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
            background: white;
        }

        .icon-circle {
            background-color: #f1f3f9;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4a5568;
            flex-shrink: 0;
        }

        .custom-input-group input, .custom-input-group select {
            border: none;
            outline: none;
            width: 100%;
            padding: 8px 12px;
            font-size: 0.95rem;
            background: transparent;
        }

        .action-row {
            display: flex;
            gap: 15px;
            margin-top: 1.5rem;
        }

        .btn-action-blue {
            flex: 1;
            background-color: #1e74ed;
            color: white;
            font-weight: 600;
            border-radius: 30px;
            padding: 10px;
            text-align: center;
            text-decoration: none;
            border: none;
            box-shadow: 0 4px 12px rgba(30, 116, 237, 0.25);
        }

            .btn-action-blue:hover {
                background-color: #1663cc;
                color: white;
            }

        .step-panel {
            display: none;
        }

            .step-panel.active {
                display: block;
            }

        .role-section-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #1a202c;
            letter-spacing: 0.5px;
            margin-bottom: 0.75rem;
        }

        .role-toggle-box {
            display: flex;
            gap: 15px;
            margin-bottom: 1.5rem;
        }

        .btn-role {
            flex: 1;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            border-radius: 14px;
            padding: 10px;
            font-weight: 600;
            color: #1a202c;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
        }

            .btn-role.active {
                background: #e2e8f0;
                border-color: #cbd5e1;
            }
    </style>
</head>
<body>

    <div class="register-card">
        <div class="header-section">
            <a href="@(isEditMode ? (userRole == "Worker" ? Url.Action("WorkerDashboard", "WorkerDashboard") : Url.Action("ClientProfile", "Dashboard")) : Url.Action("Login", "Auth"))" class="btn-back-circle">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h2 class="header-title">@(isEditMode ? "Edit Profile" : "Create Account")</h2>
            <img src="/Images/logo.png" alt="Logo" style="width: 25px; height: 25px;" />
        </div>

        @if (!Html.ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 text-center row g-0" style="border-radius: 15px; font-size: 0.85rem; list-style: none;">
                @Html.ValidationSummary(true, "")
            </div>
        }

        @if (!isEditMode)
        {
            <div id="roleSelectionWrapper">
                <div class="role-section-title">SELECT ROLE</div>
                <div class="role-toggle-box">
                    <div class="btn-role @(userRole == "Client" ? "active" : "")" id="roleClient" onclick="switchRole('Client')">
                        <div class="icon-circle"><i class="fa-solid fa-user"></i></div> Client
                    </div>
                    <div class="btn-role @(userRole == "Worker" ? "active" : "")" id="roleWorker" onclick="switchRole('Worker')">
                        <div class="icon-circle"><i class="fa-solid fa-user-tie"></i></div> Worker
                    </div>
                </div>
            </div>
        }

        <form id="signupForm" action="@(isEditMode ? (userRole == "Worker" ? Url.Action("UpdateWorker", "WorkerDashboard") : Url.Action("EditProfile", "Dashboard")) : Url.Action("Register", "Auth"))" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Role" id="selectedRole" value="@userRole" />
            <input type="hidden" id="TempPicturePath" name="TempPicturePath" />
            <input type="hidden" id="SessionSkillsData" name="SessionSkillsData" />

            @if (isEditMode)
            {
                if (userRole == "Worker")
                {
                    <input type="hidden" name="WorkerId" value="@mId" />
                }
                else if (userRole == "Client")
                {
                    <input type="hidden" name="ClientId" value="@mId" />
                }
            }

            @* ---------------- CLIENT PANEL (SIGNUP + EDIT) ---------------- *@
            <div id="panelClient" class="step-panel @(userRole == "Client" ? "active" : "")">
                <div class="custom-input-group">
                    <div class="icon-circle"><i class="fa-regular fa-user"></i></div>
                    <input type="text" id="clientNameInput" name="ClientName" placeholder="Full Name" value="@mName" />
                </div>
                <div class="custom-input-group">
                    <div class="icon-circle"><i class="fa-regular fa-envelope"></i></div>
                    <input type="email" id="clientEmailInput" name="ClientEmail" placeholder="Email" value="@mEmail" />
                </div>
                <div class="custom-input-group">
                    <div class="icon-circle"><i class="fa-solid fa-phone"></i></div>
                    <input type="tel" id="clientPhoneInput" name="ClientPhone" placeholder="Phone no" value="@mPhone" />
                </div>
                <div class="custom-input-group">
                    <div class="icon-circle"><i class="fa-regular fa-image"></i></div>
                    <input type="file" name="ClientPicture" accept="image/*" style="padding: 4px;" />
                </div>

                @if (isEditMode && userRole == "Client")
                {
                    <div class="d-flex align-items-center justify-content-center gap-3 my-2 p-2 border rounded-pill bg-light" style="max-width: 280px; margin: 0 auto;">
                        @if (!string.IsNullOrEmpty(mPicture))
                        {
                            <img src="@mPicture" style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover; border: 2px solid #1e74ed;" alt="Current Profile" />
                        }
                        else
                        {
                            <div class="icon-circle border" style="width: 45px; height: 45px; font-size: 1.2rem;"><i class="fa-solid fa-user text-secondary"></i></div>
                        }
                        <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Current Profile Picture</span>
                    </div>
                }

                <div class="custom-input-group">
                    <div class="icon-circle"><i class="fa-solid fa-house"></i></div>
                    <input type="text" name="ClientAddress" placeholder="Address" value="@mAddress" />
                </div>

                @if (!isEditMode)
                {
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-lock"></i></div>
                        <input type="password" id="clientPass" name="ClientPassword" placeholder="Password" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-lock"></i></div>
                        <input type="password" id="clientConfirmPass" name="ClientConfirmPassword" placeholder="Confirm Password" />
                    </div>
                }

                <div class="action-row">
                    <a href="@(isEditMode ? Url.Action("ClientProfile", "Dashboard") : Url.Action("Login", "Auth"))" class="btn-action-blue text-center" style="line-height: 24px;">Back</a>
                    <button type="submit" class="btn-action-blue">@(isEditMode ? "Update" : "Signup")</button>
                </div>
            </div>

            @if (isEditMode && userRole == "Worker")
            {
                @* ---------------- WORKER EDIT MODE ---------------- *@
                <div id="panelWorkerEdit" class="step-panel active">
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-user"></i></div>
                        <input type="text" name="WorkerName" placeholder="Full Name" value="@mName" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-calendar"></i></div>
                        <input type="number" name="WorkerAge" placeholder="Age" value="@mAge" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-phone"></i></div>
                        <input type="tel" name="WorkerPhone" placeholder="Phone no" value="@mPhone" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-id-card"></i></div>
                        <input type="text" name="WorkerCNIC" placeholder="CNIC" value="@mCnic" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-dollar-sign"></i></div>
                        <input type="number" name="WorkerSalary" placeholder="Salary" value="@mSalary" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-venus-mars"></i></div>
                        <select name="WorkerGender">
                            <option value="Male" selected="@(mGender == "Male" ? "selected" : null)">Male</option>
                            <option value="Female" selected="@(mGender == "Female" ? "selected" : null)">Female</option>
                        </select>
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-image"></i></div>
                        <input type="file" name="WorkerPicture" accept="image/*" style="padding: 4px;" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-envelope"></i></div>
                        <input type="email" name="WorkerEmail" placeholder="Email" value="@mEmail" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-house"></i></div>
                        <input type="text" name="WorkerAddress" placeholder="Address" value="@mAddress" />
                    </div>

                    <a href="@Url.Action("AddSkills", "Auth")" class="custom-input-group text-decoration-none" style="display: flex; justify-content: space-between; align-items: center;">
                        <div class="d-flex align-items-center" style="gap: 12px; width: 100%;">
                            <div class="icon-circle" style="background: #e6f4ea; color: #137333;">
                                <i class="fa-solid fa-briefcase"></i>
                            </div>
                            <span class="text-secondary" style="font-size: 0.95rem;">Skills & Experience Details</span>
                        </div>
                        <div class="icon-circle border-0 text-primary bg-transparent" style="margin-right: -4px;">
                            <i class="fa-solid fa-chevron-right" style="font-size: 0.85rem;"></i>
                        </div>
                    </a>

                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-lock"></i></div>
                        <input type="password" name="WorkerPassword" placeholder="Password" value="" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-lock"></i></div>
                        <input type="password" name="WorkerConfirmPassword" placeholder="Confirm Password" value="" />
                    </div>

                    <div class="d-flex align-items-center justify-content-center gap-3 my-2 p-2 border rounded-pill bg-light" style="max-width: 280px; margin: 0 auto;">
                        @if (!string.IsNullOrEmpty(mPicture))
                        {
                            <img src="@mPicture" style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover; border: 2px solid #1e74ed;" alt="Profile" />
                        }
                        else
                        {
                            <div class="icon-circle border" style="width: 45px; height: 45px; font-size: 1.2rem;"><i class="fa-solid fa-user-tie text-secondary"></i></div>
                        }
                        <span class="text-secondary fw-semibold" style="font-size: 0.85rem;">Current Profile Picture</span>
                    </div>

                    <div class="action-row">
                        <a href="@Url.Action("WorkerDashboard", "WorkerDashboard")" class="btn-action-blue text-center" style="line-height: 24px;">Back</a>
                        <button type="submit" class="btn-action-blue">Update</button>
                    </div>
                </div>
            }
            else
            {
                @* ---------------- WORKER SIGNUP MODE (MULTI-STEP) ---------------- *@
                <div id="panelWorkerStep1" class="step-panel @(userRole == "Worker" ? "active" : "")">
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-user"></i></div>
                        <input type="text" id="wName" name="WorkerName" placeholder="Full Name" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-calendar"></i></div>
                        <input type="number" id="wAge" name="WorkerAge" placeholder="Age" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-phone"></i></div>
                        <input type="tel" id="wPhone" name="WorkerPhone" placeholder="Phone no" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-id-card"></i></div>
                        <input type="text" id="wCnic" name="WorkerCNIC" placeholder="CNIC" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-dollar-sign"></i></div>
                        <input type="number" id="wSalary" name="WorkerSalary" placeholder="Salary" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-venus-mars"></i></div>
                        <select id="wGender" name="WorkerGender">
                            <option value="" disabled selected hidden>Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>

                    <div class="action-row">
                        <button type="button" class="btn-action-blue" onclick="goToLogin()">Home</button>
                        <button type="button" class="btn-action-blue" onclick="nextWorkerStep()">Next</button>
                    </div>
                </div>

                <div id="panelWorkerStep2" class="step-panel">
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-image"></i></div>
                        <input type="file" name="WorkerPicture" id="workerPicInput" accept="image/*" style="padding: 4px;" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-regular fa-envelope"></i></div>
                        <input type="email" id="wEmail" name="WorkerEmail" placeholder="Email" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-house"></i></div>
                        <input type="text" id="wAddress" name="WorkerAddress" placeholder="Address" />
                    </div>

                    <a href="@Url.Action("AddSkills", "Auth")" onclick="saveWorkerDraft()" class="custom-input-group justify-content-between pe-1 text-decoration-none" style="cursor: pointer; display: flex;">
                        <div class="d-flex align-items-center flex-grow-1" style="gap: 8px;">
                            <div class="icon-circle" style="background: #e6f4ea; color: #137333;"><i class="fa-solid fa-check"></i></div>
                            <span class="text-secondary fs-6">Add / Edit Skills</span>
                        </div>
                        <div class="icon-circle border-0 text-primary" style="background: #dbeafe;"><i class="fa-solid fa-plus"></i></div>
                    </a>

                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-lock"></i></div>
                        <input id="workerPass" name="WorkerPassword" placeholder="Password" type="password" />
                    </div>
                    <div class="custom-input-group">
                        <div class="icon-circle"><i class="fa-solid fa-lock"></i></div>
                        <input id="workerConfirmPass" name="WorkerConfirmPassword" placeholder="Confirm Password" type="password" />
                    </div>

                    <div class="action-row">
                        <button class="btn-action-blue" onclick="backToWorkerStep1()" type="button">Back</button>
                        <button class="btn-action-blue" type="submit">Signup</button>
                    </div>
                </div>
            }
        </form>
    </div>

    <script>
        function switchRole(role) {
            document.getElementById('selectedRole').value = role;
            if (role === 'Client') {
                document.getElementById('roleClient').classList.add('active');
                document.getElementById('roleWorker').classList.remove('active');
                document.getElementById('panelClient').classList.add('active');
                if (document.getElementById('panelWorkerStep1')) document.getElementById('panelWorkerStep1').classList.remove('active');
                if (document.getElementById('panelWorkerStep2')) document.getElementById('panelWorkerStep2').classList.remove('active');
            } else {
                document.getElementById('roleWorker').classList.add('active');
                document.getElementById('roleClient').classList.remove('active');
                
                var hasDraft = localStorage.getItem("WorkerDraftData");
                if (hasDraft && document.getElementById('panelWorkerStep2')) {
                    document.getElementById('panelWorkerStep2').classList.add('active');
                    if (document.getElementById('panelWorkerStep1')) document.getElementById('panelWorkerStep1').classList.remove('active');
                } else {
                    if (document.getElementById('panelWorkerStep1')) document.getElementById('panelWorkerStep1').classList.add('active');
                    if (document.getElementById('panelWorkerStep2')) document.getElementById('panelWorkerStep2').classList.remove('active');
                }
                document.getElementById('panelClient').classList.remove('active');
            }
        }

        function nextWorkerStep() {
            var wName = document.getElementsByName('WorkerName')[0]?.value.trim();
            var wPhone = document.getElementsByName('WorkerPhone')[0]?.value.trim();
            var wCnic = document.getElementsByName('WorkerCNIC')[0]?.value.trim();

            if (!wName || !wPhone || !wCnic) {
                alert('Please fill all mandatory fields (Name, Phone, CNIC) for Worker.');
                return;
            }

            if (wCnic.replace(/[^0-9]/g, "").length !== 13) {
                alert('Please enter a valid 13-digit CNIC number.');
                return;
            }

            document.getElementById('panelWorkerStep1').classList.remove('active');
            document.getElementById('panelWorkerStep2').classList.add('active');
        }

        function backToWorkerStep1() {
            document.getElementById('panelWorkerStep2').classList.remove('active');
            document.getElementById('panelWorkerStep1').classList.add('active');
        }

        function goToLogin() { window.location.href = '@Url.Action("Login", "Auth")'; }

        function saveWorkerDraft() {
            var draft = {
                wName: document.getElementById('wName')?.value || '',
                wAge: document.getElementById('wAge')?.value || '',
                wPhone: document.getElementById('wPhone')?.value || '',
                wCnic: document.getElementById('wCnic')?.value || '',
                wSalary: document.getElementById('wSalary')?.value || '',
                wGender: document.getElementById('wGender')?.value || '',
                wEmail: document.getElementById('wEmail')?.value || '',
                wAddress: document.getElementById('wAddress')?.value || ''
            };
            localStorage.setItem("WorkerDraftData", JSON.stringify(draft));
        }

        window.addEventListener('DOMContentLoaded', function () {
            const urlParams = new URLSearchParams(window.location.search);
            const roleParam = urlParams.get('role') || urlParams.get('tab');
            var viewBagRole = "@userRole";

            if ((roleParam && roleParam.toLowerCase() === 'worker') || viewBagRole === 'Worker') {
                switchRole('Worker');
            }

            var savedDraft = localStorage.getItem("WorkerDraftData");
            if (savedDraft) {
                var draft = JSON.parse(savedDraft);
                if (draft.wName && document.getElementById('wName')) document.getElementById('wName').value = draft.wName;
                if (draft.wAge && document.getElementById('wAge')) document.getElementById('wAge').value = draft.wAge;
                if (draft.wPhone && document.getElementById('wPhone')) document.getElementById('wPhone').value = draft.wPhone;
                if (draft.wCnic && document.getElementById('wCnic')) document.getElementById('wCnic').value = draft.wCnic;
                if (draft.wSalary && document.getElementById('wSalary')) document.getElementById('wSalary').value = draft.wSalary;
                if (draft.wGender && document.getElementById('wGender')) document.getElementById('wGender').value = draft.wGender;
                if (draft.wEmail && document.getElementById('wEmail')) document.getElementById('wEmail').value = draft.wEmail;
                if (draft.wAddress && document.getElementById('wAddress')) document.getElementById('wAddress').value = draft.wAddress;
            }

            var storedSkills = localStorage.getItem("workerSkillsJson");
            if (storedSkills && document.getElementById('SessionSkillsData')) {
                document.getElementById('SessionSkillsData').value = storedSkills;
            }
        });

        document.getElementById('signupForm').addEventListener('submit', function (e) {
            var role = document.getElementById('selectedRole').value;
            var isEditMode = @(isEditMode ? "true" : "false");

            if (role === 'Client') {
                var cName = document.getElementById('clientNameInput')?.value.trim();
                var cEmail = document.getElementById('clientEmailInput')?.value.trim();
                var cPhone = document.getElementById('clientPhoneInput')?.value.trim();

                if (!cName || !cEmail || !cPhone) {
                    alert('Please fill all mandatory fields (Name, Email, Phone) for Client.');
                    e.preventDefault();
                    return;
                }

                if (!isEditMode) {
                    var cPass = document.getElementById('clientPass')?.value;
                    var cConfPass = document.getElementById('clientConfirmPass')?.value;

                    if (!cPass || cPass.trim() === "") {
                        alert('Password is required for Client Signup.');
                        e.preventDefault();
                        return;
                    }
                    if (cPass !== cConfPass) {
                        alert('Client Passwords do not match!');
                        e.preventDefault();
                        return;
                    }
                }
            }

            if (role === 'Worker') {
                var wName = document.getElementsByName('WorkerName')[0]?.value.trim();
                var wPhone = document.getElementsByName('WorkerPhone')[0]?.value.trim();
                var wCnic = document.getElementsByName('WorkerCNIC')[0]?.value.trim();

                if (!wName || !wPhone || !wCnic) {
                    alert('Please fill all mandatory fields (Name, Phone, CNIC) for Worker.');
                    e.preventDefault();
                    if (!isEditMode) { backToWorkerStep1(); }
                    return;
                }

                if (wCnic.replace(/[^0-9]/g, "").length !== 13) {
                    alert('Please enter a valid 13-digit CNIC number.');
                    e.preventDefault();
                    if (!isEditMode) { backToWorkerStep1(); }
                    return;
                }

                if (!isEditMode) {
                    var wPass = document.getElementById('workerPass') ? document.getElementById('workerPass').value : "";
                    var wConfPass = document.getElementById('workerConfirmPass') ? document.getElementById('workerConfirmPass').value : "";

                    if (!wPass || !wConfPass) {
                        alert('Password fields are required for Worker Signup.');
                        e.preventDefault();
                        return;
                    }
                    if (wPass !== wConfPass) {
                        alert('Worker Passwords do not match!');
                        e.preventDefault();
                        return;
                    }
                    localStorage.removeItem("WorkerDraftData");
                } else {
                    var wPassEdit = document.getElementsByName('WorkerPassword')[0]?.value;
                    var wConfPassEdit = document.getElementsByName('WorkerConfirmPassword')[0]?.value;
                    if (wPassEdit && wPassEdit !== wConfPassEdit) {
                        alert('Passwords do not match!');
                        e.preventDefault();
                        return;
                    }
                }
            }
        });
    </script>
</body>
</html>